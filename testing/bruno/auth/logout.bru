meta {
  name: Logout
  type: http
  seq: 6
}

get {
  url: http://localhost:8080/?action=auth/logout
  body: none
  auth: none
}

tests {
  test("Redirect ke login page dengan parameter logout=1", function() {
    // Front-controller: action logoutUser() -> redirect ke /login.php?logout=1 (302).
    // Bruno follow-redirect otomatis, jadi status akhir adalah 200 dari login.php
    expect(res.getStatus()).to.be.oneOf([200, 302]);
  });

  test("Terdapat pesan sukses logout jika follow redirect", function() {
    // Catatan: Tanpa session aktif, front-controller (public/index.php line 7) requireAuth()
    // melakukan redirect ke /login.php SEBELUM sampai ke action auth/logout.
    // Jadi pesan 'Sesi berhasil diakhiri' hanya muncul kalau Bruno sudah punya session.
    // Test ini PASS jika: ada session → 'Sesi berhasil diakhiri' tampil;
    //                  tidak ada session → redirect ke login form (tetap dianggap OK).
    if (res.getStatus() === 200) {
      const ok = res.getBody().includes('Sesi berhasil diakhiri')
              || res.getBody().includes('Masuk ke Gajiku');
      expect(ok).to.be.true;
    }
  });
}
