meta {
  name: Login Invalid Password
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/login.php
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: admin
  password: wrongpassword
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Menampilkan pesan error login", function() {
    expect(res.getBody().includes('Username atau password salah')).to.be.true;
  });
}
