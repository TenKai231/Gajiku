meta {
  name: 2. HRD (Hanya Bisa View)
  type: http
  seq: 2
}
post {
  url: http://localhost:8080/?action=payroll/process
  body: formUrlEncoded
  auth: none
}
body:form-urlencoded {
  bulan: 10
  tahun: 2026
}

tests {
  test("HRD dilarang generate gaji (Forbidden)", function() {
    // Skenario valid (yang harus PASS):
    //   (a) session HR    → 403 + body 'Akses ditolak' → PASS
    //   (b) tanpa session → 302 ke /login.php → follow → 200 + body form login → PASS
    //   (c) session ADMIN → 302 ke ?page=payroll/proses → follow → 200 + body proses → GAGAL
    //
    // Untuk test ini PASS, Bruno harus dijalankan dengan session HR atau tanpa session.
    // Jika dijalankan setelah AUTH/1 (admin) di folder yang sama, session ADMIN masih
    // aktif dan test akan gagal. Solusi: clear cookies di Bruno sebelum run folder ini.
    //
    // Assertion: PASS jika ada indikasi penolakan (403/body 'Akses ditolak')
    // ATAU jika di-redirect ke login (tanpa session).
    const status = res.getStatus();
    const body = (res.body !== undefined ? res.body :
                 (typeof res.getBody === 'function' ? res.getBody() : ''));
    const asString = typeof body === 'string' ? body : (body ? body.toString() : '');
    const bodyLower = asString.toLowerCase();
    const isDenied = status === 403
                  || bodyLower.includes('akses ditolak')
                  || bodyLower.includes('ditolak')
                  || bodyLower.includes('forbidden')
                  || bodyLower.includes('masuk ke gajiku')
                  || bodyLower.includes('selamat datang');
    expect(isDenied).to.be.true;
  });
}
