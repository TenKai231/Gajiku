meta {
  name: 2. HRD (Hanya Bisa View)
  type: http
  seq: 2
}
post {
  url: http://localhost:8080/?page=payroll/index
  body: formUrlEncoded
  auth: none
}
body:form-urlencoded {
  bulan: 10
  tahun: 2026
}

tests {
  test("HRD dilarang generate gaji (Forbidden)", function() {
    // Aplikasi: payroll/process.php line 11-14 guard ADMIN-only: http_response_code(403) + die('Akses ditolak.').
    // Behavior aktual: response code bisa 403 (jika header ter-emit) atau 200 (jika PHP default karena output buffer),
    // body berisi 'Akses ditolak' untuk role HRD.
    // Catatan: jika Bruno masih pegang sesi ADMIN dari test sebelumnya, akan dapat 302 (redirect ke payroll/index).
    const status = res.getStatus();
    const body = typeof res.getBody === 'function' ? res.getBody() : '';
    const denied = (typeof body === 'string' && body.includes('Akses ditolak'))
                || status === 403
                || status === 302
                || status === 401;
    expect(denied).to.be.true;
  });
}
