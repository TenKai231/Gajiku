meta {
  name: 2. HRD (Hanya Bisa View)
  type: http
  seq: 2
}
post {
  url: http://localhost:8080/?action=payroll/process
  body: formUrlEncoded
  auth: none
}
body:form-urlencoded {
  bulan: 10
  tahun: 2026
}

tests {
  test("HRD dilarang generate gaji (Forbidden)", function() {
    // HRD mencoba POST generate payroll. Aplikasi: payroll/process.php line 11-14
    // http_response_code(403) + die('Akses ditolak.') → response 403 body 'Akses ditolak'.
    const status = res.getStatus();
    const body = typeof res.getBody === 'function' ? res.getBody() : '';
    const denied = status === 403
                || (typeof body === 'string' && body.includes('Akses ditolak'));
    expect(denied).to.be.true;
  });
}
