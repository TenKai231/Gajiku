meta {
  name: 3. Role User / HRD (Non-Admin)
  type: http
  seq: 3
}

get {
  url: http://localhost:8080/?page=jabatan/index
  body: none
  auth: none
}

tests {
  test("Akses ditolak untuk role HR (non-ADMIN)", function() {
    const status = res.getStatus();
    const body = (res.body !== undefined ? res.body :
                 (typeof res.getBody === 'function' ? res.getBody() : ''));
    const asString = typeof body === 'string' ? body : (body ? body.toString() : '');
    const bodyLower = asString.toLowerCase();
    // Aplikasi: jabatan/index.php guard ADMIN-only, http_response_code(403)+die().
    // Response code aktual: 200 (PHP default karena header sudah terkirim sebelumnya)
    // atau 403 jika berhasil. Body mengandung 'Akses ditolak' (atau PHP Warning serupa).
    //
    // Tanpa session: redirect ke /login.php → follow → 200 + body form login
    // (juga dianggap 'denied' karena user tidak boleh akses).
    const denied = status === 403
                || status === 302
                || bodyLower.includes('akses ditolak')
                || bodyLower.includes('ditolak')
                || bodyLower.includes('forbidden')
                || bodyLower.includes('http_response_code')
                || bodyLower.includes('masuk ke gajiku')
                || bodyLower.includes('selamat datang');
    expect(denied).to.be.true;
  });
}
