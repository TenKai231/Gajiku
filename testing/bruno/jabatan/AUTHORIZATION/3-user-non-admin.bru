meta {
  name: 3. Role User / HRD (Non-Admin)
  type: http
  seq: 3
}

get {
  url: http://localhost:8080/?page=jabatan/index
  body: none
  auth: none
}

tests {
  test("Akses ditolak untuk role HR (non-ADMIN)", function() {
    // Aplikasi: jabatan/index.php guard ADMIN-only.
    // Respons berisi teks 'Akses ditolak'. Response code default 200 karena PHP die()
    // dipanggil setelah http_response_code(403) yang tidak di-emit jika buffer sudah terkontaminasi,
    // atau bisa 403 jika berhasil di-emit. Cek kombinasi:
    const status = res.getStatus();
    const body = typeof res.getBody === 'function' ? res.getBody() : '';
    const denied = (typeof body === 'string' && body.includes('Akses ditolak'))
                || status === 403
                || status === 302;
    expect(denied).to.be.true;
  });
}
