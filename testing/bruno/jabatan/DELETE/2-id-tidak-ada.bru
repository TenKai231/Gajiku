meta {
  name: 2. Delete ID Tidak Ada
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/jabatan.php?action=delete
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  id: 99999
}

tests {
  test("Delete gagal gracefully jika ID tidak ditemukan", function() {
    expect(res.getStatus()).to.be.oneOf([200, 302, 404]);
  });
}
