meta {
  name: 3. Delete Tanpa Authorization
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/?action=karyawan/delete
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  id: 1
}


tests {
  test("Dilarang melakukan aksi tanpa sesi / role admin", function() {
    // Aplikasi: requireAuth() → redirect ke /login.php (302). Bruno follow-redirect otomatis
    // sehingga status akhir bisa 200 (login page) atau 302 (jika follow dimatikan).
    const status = res.getStatus();
    const body = res.getBody();
    const redirectedToLogin = body.includes('Masuk ke Gajiku') || body.includes('login');
    expect([200, 302, 403, 401].includes(status) && (status === 302 || status === 403 || status === 401 || redirectedToLogin)).to.be.true;
  });
}
